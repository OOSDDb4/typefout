<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Typefout.App.ViewModels"
             x:Class="Typefout.App.Views.PasswordReset2Page"
                      BackgroundColor="White">

    <VerticalStackLayout Spacing="0"
                         Padding="30"
                         VerticalOptions="Center">

        <Label Text="Er is een verficatiecode gestuurd naar:"
               TextColor="#333333"
               FontSize="25"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center"
               Margin="0,0,0,25" />
        <Label x:Name="EmailLabel"
               Text="{Binding UserEmail}"
               TextColor="#333333"
               FontSize="25"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center"
               Margin="0,0,0,25" />
        <Label Text="De code is 5 minuten geldig"
               TextColor="#333333"
               FontSize="25"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center"
               Margin="0,0,0,25" />

        <VerticalStackLayout Spacing="15" 
                     Margin="0,0,0,80"
                     WidthRequest="450">
            
            <HorizontalStackLayout Spacing="4" 
                           HorizontalOptions="Center">

                <HorizontalStackLayout.Resources>
                    <Style TargetType="Entry">
                        <Setter Property="WidthRequest" Value="30" />
                        <Setter Property="HeightRequest" Value="50" />
                        <Setter Property="MaxLength" Value="1" />
                        <Setter Property="Keyboard" Value="Numeric" />
                        <Setter Property="HorizontalTextAlignment" Value="Center" />
                        <Setter Property="VerticalTextAlignment" Value="Center" />
                        <Setter Property="BackgroundColor" Value="#F0F0F0" />
                        <Setter Property="TextColor" Value="Black" />
                        <Setter Property="FontSize" Value="20" />
                    </Style>
                </HorizontalStackLayout.Resources>

                <Entry x:Name="Digit1" Text="{Binding Digit1}" TextChanged="OnDigitTextChanged" />
                <Entry x:Name="Digit2" Text="{Binding Digit2}" TextChanged="OnDigitTextChanged" />
                <Entry x:Name="Digit3" Text="{Binding Digit3}" TextChanged="OnDigitTextChanged" />
                <Entry x:Name="Digit4" Text="{Binding Digit4}" TextChanged="OnDigitTextChanged" />
                <Entry x:Name="Digit5" Text="{Binding Digit5}" TextChanged="OnDigitTextChanged" />
                <Entry x:Name="Digit6" Text="{Binding Digit6}" TextChanged="OnDigitTextChanged" />

            </HorizontalStackLayout>
            <Label Text="{Binding ErrorMessage}" 
                   TextColor="Red" 
                   FontSize="12"
                   HorizontalOptions="Center"/>
        </VerticalStackLayout>

        <Grid ColumnDefinitions="*,*" ColumnSpacing="20"
          WidthRequest="350">

            <Button Grid.Column="0"
                    Text="Annuleren"
                    Clicked="OnBackClicked"
                    TextColor="Black"
                    BackgroundColor="White"
                    BorderColor="#CCCCCC"
                    BorderWidth="1"
                    CornerRadius="5"
                    HeightRequest="60"
                    FontAttributes="None">
                <Button.Shadow>
                    <Shadow Brush="Black"
                            Offset="2,2"
                            Radius="5"
                            Opacity="0.2" />
                </Button.Shadow>
            </Button>

            <Button Grid.Column="1"
                    Text="Invoeren"
                    Clicked="OnInvoerClicked"
                    TextColor="Black"
                    BackgroundColor="White"
                    BorderColor="#CCCCCC"
                    BorderWidth="1"
                    CornerRadius="5"
                    HeightRequest="60"
                    FontAttributes="None">
                <Button.Shadow>
                    <Shadow Brush="Black"
                            Offset="2,2"
                            Radius="5"
                            Opacity="0.2" />
                </Button.Shadow>
            </Button>
        </Grid>

    </VerticalStackLayout>
</ContentPage>