<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Typefout.App.Views.SchoolContentView">
    
    <Border BackgroundColor="#E0E0E0" 
            StrokeShape="RoundRectangle 10" 
            Padding="30" 
            VerticalOptions="FillAndExpand">
        
        <StackLayout Spacing="20">
            
            <Label Text="Schoolnaam: Tweesprong" 
                   FontSize="18" 
                   FontAttributes="None" />
            
            <Label Text="Docenten" 
                   FontSize="20" 
                   FontAttributes="Bold" 
                   Margin="0, 10, 0, 0"/>

            <Grid RowDefinitions="Auto, Auto, Auto, *" 
                  RowSpacing="1" 
                  VerticalOptions="Start">
                
                <BoxView Grid.Row="0" HeightRequest="40" BackgroundColor="White" />
                <BoxView Grid.Row="1" HeightRequest="40" BackgroundColor="White" />
                <BoxView Grid.Row="2" HeightRequest="40" BackgroundColor="White" />
                <BoxView Grid.Row="3" BackgroundColor="Transparent" VerticalOptions="FillAndExpand" />
            </Grid>
        </StackLayout>
    </Border>
</ContentView>