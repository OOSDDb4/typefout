<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Typefout.App.Views"
             xmlns:vm="clr-namespace:Typefout.App.ViewModels"
             x:Class="Typefout.App.Views.TeacherPage"
             BackgroundColor="White">

    <ContentPage.Resources>
        <Style x:Key="MenuItemStyle" TargetType="Border">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="HeightRequest" Value="40"/>
            <Setter Property="StrokeShape" Value="RoundRectangle 0"/>
            <Setter Property="Margin" Value="0, 0, 0, 1"/>
            <Setter Property="BackgroundColor" Value="Transparent"/>
            <Setter Property="MaximumWidthRequest" Value="200"/>

            <Style.Triggers>
                <DataTrigger TargetType="Border" Binding="{Binding PageTitle}" Value="School">
                    <Setter Property="BackgroundColor" Value="#CCCCFF"/>
                </DataTrigger>

                <DataTrigger TargetType="Border" Binding="{Binding PageTitle}" Value="Groepen">
                    <Setter Property="BackgroundColor" Value="#CCCCFF"/>
                </DataTrigger>

                <DataTrigger TargetType="Border" Binding="{Binding PageTitle}" Value="Leerlingen">
                    <Setter Property="BackgroundColor" Value="#CCCCFF"/>
                </DataTrigger>

                <DataTrigger TargetType="Border" Binding="{Binding PageTitle}" Value="Instellingen">
                    <Setter Property="BackgroundColor" Value="#CCCCFF"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ContentPage.Resources>

    <Grid ColumnDefinitions="200, *">

        <ScrollView Grid.Column="0" BackgroundColor="#E0E0E0">
            <StackLayout Padding="15, 30, 15, 30" Spacing="1">

                <Border Style="{StaticResource MenuItemStyle}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ChangePageCommand}" CommandParameter="School" />
                    </Border.GestureRecognizers>
                    <Label Text="School" VerticalOptions="Center" TextColor="Black" />
                </Border>

                <Border Style="{StaticResource MenuItemStyle}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ChangePageCommand}" CommandParameter="Groepen" />
                    </Border.GestureRecognizers>
                    <Label Text="Groepen" VerticalOptions="Center" TextColor="Black" />
                </Border>

                <Border Style="{StaticResource MenuItemStyle}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ChangePageCommand}" CommandParameter="Students" />
                    </Border.GestureRecognizers>
                    <Label Text="Leerlingen" VerticalOptions="Center" TextColor="Black" />
                </Border>

                <Border Style="{StaticResource MenuItemStyle}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ChangePageCommand}" CommandParameter="Instellingen" />
                    </Border.GestureRecognizers>
                    <Label Text="Instellingen" VerticalOptions="Center" TextColor="Black" />
                </Border>

            </StackLayout>
        </ScrollView>

        <StackLayout Grid.Column="1" Padding="40, 20, 40, 20">

            <Label Text="{Binding PageTitle}" 
                   FontSize="36" 
                   FontAttributes="Bold" 
                   Margin="0, 0, 0, 30" 
                   HorizontalOptions="Center"/>

            <ContentView Content="{Binding CurrentContent}" VerticalOptions="Fill" />

        </StackLayout>
    </Grid>
</ContentPage>