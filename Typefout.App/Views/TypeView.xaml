<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Typefout.App.ViewModels"
             x:Class="Typefout.App.Views.TypeView"
             BackgroundColor="White">

    <VerticalStackLayout Spacing="20"  HorizontalOptions="Center">


        <Grid Padding="0,20,0,100" VerticalOptions="Start" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width= "900"/>
            </Grid.ColumnDefinitions>

            <VerticalStackLayout Grid.Column="0" Spacing="5">
                <Label Text="Typefout"
                       FontSize="48"
                       HorizontalOptions="Start"
                       FontAttributes="Bold"
                       TextColor="Black"/>
            </VerticalStackLayout>

            <Button Grid.Column="1"
                    Text="Stoppen"
                    VerticalOptions="Start"
                    HorizontalOptions="End"
                    BackgroundColor="#D3D3D3"
                    TextColor="Black"
                    FontSize="20"
                    Command="{Binding StopExerciseCommand}"/>
        </Grid>

        <Label Text="Typ het woord over:" 
               FontSize="40" 
               HorizontalOptions="Center" 
               TextColor="Black" />

       
        <Label Text="{Binding TargetWord}"
               FontSize="60"
               FontAttributes="Bold"
               TextColor="Black"
               HorizontalOptions="Center" />

    
        <Label FontSize="50"
               HorizontalOptions="Center">
            <Label.FormattedText>
                <Binding Path="HighlightedText" />
            </Label.FormattedText>
        </Label>

      
        <Entry Text="{Binding InputText}"
               TextColor="Black"
               Placeholder="Typ hier..."
               WidthRequest="300"
               HorizontalTextAlignment="Center"
               FontSize="50" />

    </VerticalStackLayout>

</ContentPage>
