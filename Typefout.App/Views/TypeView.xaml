<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Typefout.App.ViewModels"
             x:Class="Typefout.App.Views.TypeView"
             BackgroundColor="White">
    

    <VerticalStackLayout Spacing="20" VerticalOptions="Center" HorizontalOptions="Center">

        <Label Text="Typ het woord over:" FontSize="40" HorizontalOptions="Center" TextColor="Black" />

        <Label Text="{Binding TargetWord}"
               FontSize="60"
               FontAttributes="Bold"
               TextColor="Black"
               HorizontalOptions="Center" />

        <Entry Text="{Binding InputText}"
               TextColor="Black"
               Placeholder="Typ hier..."
               WidthRequest="300"
               HorizontalTextAlignment="Center"
               FontSize="50" />
    </VerticalStackLayout>
</ContentPage>