<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Typefout.App.ViewModels"
             x:Class="Typefout.App.Views.LoginPage"
             BackgroundColor="White">

    <VerticalStackLayout VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="30"
                             WidthRequest="350">
        <VerticalStackLayout Spacing="5">
            <Label Text="Gebruikersnaam/email:"
                       TextColor="#333333"
                       FontSize="14" />

            <Entry Text="{Binding LoginInput}"
                       TextColor="Black"
                       FontSize="16"
                       Placeholder="Voer je email in"
                       Background="Transparent" />

            <BoxView HeightRequest="1"
                         Color="Gray"
                         HorizontalOptions="Fill" />
        </VerticalStackLayout>


        <VerticalStackLayout Spacing="5">
            <Label Text="Wachtwoord:"
                       TextColor="#333333"
                       FontSize="14"
                       Margin="0,20,0,0"/>
            <Grid ColumnDefinitions="*, Auto">

                <Entry x:Name="PassWord"
                           Grid.Column="0"
                           Text="{Binding PasswordInput}"
                           IsPassword="True"
                           TextColor="Black"
                           FontSize="16"
                           Background="Transparent" />

                <Grid Grid.Column="1"
                          WidthRequest="40"
                          HeightRequest="30"
                          VerticalOptions="Center"
                          HorizontalOptions="Center">

                    <Path Data="M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5M12,17C9.24,17 7,14.76 7,12C7,9.24 9.24,7 12,7C14.76,7 17,9.24 17,12C17,14.76 14.76,17 12,17M12,9C10.34,9 9,10.34 9,12C9,13.66 10.34,15 12,15C13.66,15 15,13.66 15,12C15,10.34 13.66,9 12,9Z"
                              Fill="#666666" 
                              Aspect="Uniform"
                              HeightRequest="20"
                              HorizontalOptions="Center"
                              VerticalOptions="Center" />

                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnEyeIconTapped" />
                    </Grid.GestureRecognizers>
                </Grid>
            </Grid>

            <BoxView HeightRequest="1"
                         Color="Gray"
                         HorizontalOptions="Fill" />
        </VerticalStackLayout>


        <Button Text="Inloggen"
                    TextColor="Black"
                    BorderColor="#A0A0A0"
                    Command="{Binding LoginCommand}"
                    BorderWidth="1"
                    CornerRadius="3"
                    HeightRequest="50"
                    WidthRequest="220"
                    FontSize="14"
                    Margin="0,40,0,10" 
                    HorizontalOptions="Center">

            <Button.Shadow>
                <Shadow Brush="Black" Offset="3,3" Radius="4" Opacity="0.3" />
            </Button.Shadow>

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="White" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#F5F5F5" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </VisualStateManager.VisualStateGroups>
        </Button>

        <Label Text="{Binding ErrorMessage}" 
               TextColor="Red" 
               FontSize="12"
               HorizontalOptions="Center"/>


        <Label Text="Wachtwoord vergeten"
                   TextColor="#4b39ef" 
                   FontSize="12"
                   HorizontalOptions="Center">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnLinkPressed" />
            </Label.GestureRecognizers>
        </Label>

    </VerticalStackLayout>

</ContentPage>