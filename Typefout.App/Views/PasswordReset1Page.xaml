<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Typefout.App.Views.PasswordReset1Page"
             BackgroundColor="White">

    <VerticalStackLayout Spacing="0"
                             Padding="30"
                             VerticalOptions="Center">

        <Label Text="Voer je emailadres in om een verificatiecode te krijgen"
                   TextColor="#333333"
                   FontSize="25"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Margin="0,0,0,80" />

        <VerticalStackLayout Spacing="5" Margin="0,0,0,80"
                             WidthRequest="350">
            <Label Text="Email"
                       TextColor="#333333"
                       FontSize="16" />

            <Entry Text=""
                       x:Name="Email"
                       TextColor="Black"
                       Placeholder="Vul je email in"
                       FontSize="16"
                       BackgroundColor="Transparent"
                       Margin="0" />

            <BoxView HeightRequest="1"
                         Color="Black"
                         HorizontalOptions="Fill" />

            <Label x:Name="Error" 
               TextColor="Red" 
               FontSize="12"
               HorizontalOptions="Center"/>
        </VerticalStackLayout>


        <Grid ColumnDefinitions="*,*" ColumnSpacing="20"
              WidthRequest="350">

            <Button Grid.Column="0"
                        Text="Annuleren"
                        Clicked="OnBackClicked"
                        TextColor="Black"
                        BackgroundColor="White"
                        BorderColor="#CCCCCC"
                        BorderWidth="1"
                        CornerRadius="5"
                        HeightRequest="60"
                        FontAttributes="None">
                <Button.Shadow>
                    <Shadow Brush="Black"
                                Offset="2,2"
                                Radius="5"
                                Opacity="0.2" />
                </Button.Shadow>
            </Button>

            <Button Grid.Column="1"
                        Text="Invoeren"
                        Clicked="OnSendClicked"
                        TextColor="Black"
                        BackgroundColor="White"
                        BorderColor="#CCCCCC"
                        BorderWidth="1"
                        CornerRadius="5"
                        HeightRequest="60"
                        FontAttributes="None">
                <Button.Shadow>
                    <Shadow Brush="Black"
                                Offset="2,2"
                                Radius="5"
                                Opacity="0.2" />
                </Button.Shadow>
            </Button>
        </Grid>

    </VerticalStackLayout>
</ContentPage>