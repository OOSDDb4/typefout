<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Typefout.App.Views.ResultsPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="White">
    
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" />
    </Shell.BackButtonBehavior>
    
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="25" HorizontalOptions="FillAndExpand" WidthRequest="{OnPlatform Android=Infinity, iOS=Infinity}">
            
            <Frame BackgroundColor="LightGray" 
                   Padding="10"
                   HorizontalOptions="FillAndExpand">
                <Grid ColumnDefinitions="Auto, *, Auto">
                    
                    <ImageButton Grid.Column="0"
                                 Command="{Binding RestartExerciseCommand}"
                                 BackgroundColor="Transparent"
                                 WidthRequest="50"
                                 HeightRequest="50"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Start"
                                 Padding="10">
                        <ImageButton.Source>
                            <FontImageSource 
                                Glyph="&#x21BB;"
                                FontFamily="Arial"
                                Size="30"
                                Color="Black"/>
                        </ImageButton.Source>
                    </ImageButton>
                    
                    <Label Text="Resultaten"
                           Grid.Column="1"
                           FontSize="40"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           TextColor="Black"/>
                    
                    <BoxView Grid.Column="2"
                             WidthRequest="50"
                             HeightRequest="50"
                             Color="Transparent"/>
                    
                </Grid>    
            </Frame>
            
            <Frame BackgroundColor="#e5e5e5"
                   CornerRadius="15"
                   Padding="0"
                   Margin="0, 20, 0, 0">
                
                <Grid RowDefinitions="Auto, Auto"
                      ColumnDefinitions="*, *, *, *, Auto">
                    
                    <Label Text="Oefening" Grid.Row="0" Grid.Column="0"
                           FontAttributes="Bold" HorizontalTextAlignment="Center" Padding="10"/>
                    
                    <Label Text="Moeilijke Letters" Grid.Row="0" Grid.Column="1"
                           FontAttributes="Bold" HorizontalTextAlignment="Center" Padding="10"/>
                    
                    <Label Text="Aantal fouten" Grid.Row="0" Grid.Column="2"
                           FontAttributes="Bold" HorizontalTextAlignment="Center" Padding="10"/>
                    
                    <Label Text="Type" Grid.Row="0" Grid.Column="3"
                           FontAttributes="Bold" HorizontalTextAlignment="Center" Padding="10"/>
                    
                    <Label Text="Tijd" Grid.Row="0" Grid.Column="4"
                           FontAttributes="Bold" HorizontalTextAlignment="Center" Padding="10"/>
                    
                    <Label Text="1" Grid.Row="1" Grid.Column="0"
                           HorizontalTextAlignment="Center" Padding="10"/>
                    
                    <CollectionView Grid.Row="1" Grid.Column="1"
                                    ItemsSource="{Binding WorstKeys}"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="5"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout Padding="5" Spacing="2">
                                    <Label Text="{Binding Key}" 
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="Center"/>
                                    <Label Text="{Binding Mistakes, StringFormat='{0} fout'}"
                                           FontSize="12"
                                           HorizontalTextAlignment="Center"/>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    
                    <Label Text="{Binding TotalMistakes}" 
                           Grid.Row="1" Grid.Column="2"
                           HorizontalTextAlignment="Center" 
                           VerticalTextAlignment="Center"
                           Padding="10"/>
                    
                    <Label Text="Zin" Grid.Row="1" Grid.Column="3"
                           HorizontalTextAlignment="Center" Padding="10"/>
                    
                    <Label Text="0,5 min" Grid.Row="1" Grid.Column="4"
                           HorizontalTextAlignment="Center" Padding="10"/>

                </Grid>
            </Frame>

            <Label Text="Gehaald!"
                   HorizontalTextAlignment="Center"
                   Padding="10"
                   BackgroundColor="#D0D0D0"/>

            <Button Text="Terug naar oefening kiezen"
                    BackgroundColor="LightGray"
                    TextColor="Black"
                    FontSize="22"
                    CornerRadius="12"
                    Clicked="Back_Button"
                    Margin="0,40,0,20"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>