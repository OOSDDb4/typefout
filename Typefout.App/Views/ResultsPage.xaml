<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Typefout.App.Views.ResultsPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="White">
    
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" />
    </Shell.BackButtonBehavior>
    
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="25" HorizontalOptions="FillAndExpand" WidthRequest="{OnPlatform Android=Infinity, iOS=Infinity}">
            
            <Frame BackgroundColor="LightGray" 
                   Padding="10"
                   HorizontalOptions="FillAndExpand">
                <Label Text="Resultaten"
                       FontSize="40"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       TextColor="Black"/>
            </Frame>
            
            <Frame BackgroundColor="#e5e5e5"
                   CornerRadius="15"
                   Padding="0"
                   Margin="0, 20, 0, 0">
                
                <Grid RowDefinitions="Auto, Auto"
                      ColumnDefinitions="*, *, *, *, *, *, *, Auto">
                    
                    <Label Text="Oefening" Grid.Row="0" Grid.Column="0" TextColor="Black"
                           FontAttributes="Bold" HorizontalTextAlignment="Center" Padding="10"/>

                    <Label Text="Moeilijke Letters" Grid.Row="0" Grid.Column="1" TextColor="Black"
                           FontAttributes="Bold" HorizontalTextAlignment="Center" Padding="10"/>

                    <Label Text="Aantal fouten" Grid.Row="0" Grid.Column="2" TextColor="Black"
                           FontAttributes="Bold" HorizontalTextAlignment="Center" Padding="10"/>

                    <Label Text="Type" Grid.Row="0" Grid.Column="3" TextColor="Black"
                           FontAttributes="Bold" HorizontalTextAlignment="Center" Padding="10"/>

                    <Label Text="Tijd Gebruikt" Grid.Row="0" Grid.Column="4" TextColor="Black"
                           FontAttributes="Bold" HorizontalTextAlignment="Center" Padding="10"/>
                    
                    <Label Text="Tijd Over" Grid.Row="0" Grid.Column="5" TextColor="Black"
                           FontAttributes="Bold" HorizontalTextAlignment="Center" Padding="10"/>
                    
                    <Label Text="Score Van Antwoorden" Grid.Row="0" Grid.Column="6" TextColor="Black"
                           FontAttributes="Bold" HorizontalTextAlignment="Center" Padding="10"/>
                    
                    <Label Text="Score Van Tijd Over" Grid.Row="0" Grid.Column="7" TextColor="Black"
                           FontAttributes="Bold" HorizontalTextAlignment="Center" Padding="10"/>

                    <Label Text="1" Grid.Row="1" Grid.Column="0" TextColor="Black"
                           HorizontalTextAlignment="Center" Padding="10"/>
                    
                    <CollectionView Grid.Row="1" Grid.Column="1"
                                    ItemsSource="{Binding WorstKeys}"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="5"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout Padding="5" Spacing="2">
                                    <Label Text="{Binding Key}"
                                           TextColor="Black"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="Center"/>
                                    <Label Text="{Binding Mistakes, StringFormat='{0} fout'}"
                                           TextColor="Black"
                                           FontSize="12"
                                           HorizontalTextAlignment="Center"/>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    
                    <Label Text="{Binding TotalMistakes}" 
                           TextColor="Black"
                           Grid.Row="1" Grid.Column="2"
                           HorizontalTextAlignment="Center" 
                           VerticalTextAlignment="Start"
                           Padding="10"/>
                    
                    <Label Text="Zin" Grid.Row="1" Grid.Column="3"
                           TextColor="Black"
                           HorizontalTextAlignment="Center" Padding="10"/>
                    
                    <Label Text="{Binding TimeUsed}" Grid.Row="1" Grid.Column="4"
                           TextColor="Black"
                           HorizontalTextAlignment="Center" Padding="10"/>
                    <Label Text="{Binding TimeLeft}" Grid.Row="1" Grid.Column="5"
                           TextColor="Black"
                           HorizontalTextAlignment="Center" Padding="10"/>
                    
                    <Label Text="{Binding PointsFromAnswers}" Grid.Row="1" Grid.Column="6"
                           TextColor="Black"
                           HorizontalTextAlignment="Center" Padding="10"/>
                    <Label Text="{Binding PointsFromTime}" Grid.Row="1" Grid.Column="7"
                           TextColor="Black"
                           HorizontalTextAlignment="Center" Padding="10"/>
                </Grid>
            </Frame>

            <Label Text="Gehaald!"
                   TextColor="Black"
                   HorizontalTextAlignment="Center"
                   Padding="10"
                   BackgroundColor="#D0D0D0"/>

            <Button Text="Terug naar oefening kiezen"
                    BackgroundColor="LightGray"
                    TextColor="Black"
                    FontSize="22"
                    CornerRadius="12"
                    Clicked="Back_Button"
                    Margin="0,40,0,20"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
