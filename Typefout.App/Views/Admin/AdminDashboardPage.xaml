<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Typefout.App.Views.Admin.AdminDashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Admin">

    <Grid Padding="24">
        <Frame BackgroundColor="White" CornerRadius="20" Padding="24">
            <VerticalStackLayout Spacing="20">

                <Label Text="Admin Panel"
                       FontSize="28"
                       TextColor="Black" />

                <Button Text="Scholen beheren"
                        BackgroundColor="#9B8CF2"
                        TextColor="Black"
                        Clicked="OnManageSchoolsClicked" />

                <Button Text="Oefeningen beheren"
                        BackgroundColor="#9B8CF2"
                        TextColor="Black"
                        Clicked="OnManageExercisesClicked" />

            </VerticalStackLayout>
        </Frame>
    </Grid>
</ContentPage>