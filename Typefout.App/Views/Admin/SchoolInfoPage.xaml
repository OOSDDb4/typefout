<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Typefout.App.Views.Admin"
             x:Class="Typefout.App.Views.Admin.SchoolInfoPage"
             Title="School Info">

    <local:AdminNavigationView>

        <ScrollView>
            <VerticalStackLayout Padding="40" Spacing="25">
                
                <Label Text="{Binding SchoolName}"
                       FontSize="22"
                       TextColor="Black"
                       HorizontalOptions="Center"/>

                <Frame BackgroundColor="#F0F0F0" Padding="25">
                    <VerticalStackLayout Spacing="35">

                        <VerticalStackLayout Spacing="10">

                            <Label Text="Gebruikers"
                                   FontSize="20"
                                   TextColor="Black"/>

                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  ColumnSpacing="12">

                                <Entry Grid.Column="0"
                                       WidthRequest="220"
                                       Placeholder="Naam zoeken"
                                       Text="{Binding UserSearchText}"
                                       TextColor="Black"/>

                                <Button Grid.Column="2"
                                        Text="Gebruiker toevoegen"
                                        Command="{Binding AddUserCommand}"
                                        BackgroundColor="#9B8CF2"
                                        TextColor="Black"/>
                            </Grid>

                            <Grid ColumnDefinitions="*,*,*,60,120,160"
                                  Padding="10"
                                  ColumnSpacing="10"
                                  BackgroundColor="#E0E0E0">

                                <Label Grid.Column="0" Text="Naam" TextColor="Black" />
                                <Label Grid.Column="1" Text="Type" TextColor="Black" />
                                <Label Grid.Column="2" Text="Groep" TextColor="Black" />
                                <Label Grid.Column="3" Text="Status" TextColor="Black"/>
                                <Label Grid.Column="4" Grid.ColumnSpan="2" Text="Actie" TextColor="Black" HorizontalTextAlignment="End" />
                            </Grid>

                            <CollectionView ItemsSource="{Binding Users}"
                                            HeightRequest="260">

                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*,*,*,180,Auto,Auto"
                                              Padding="10"
                                              ColumnSpacing="10">

                                            <Label Text="{Binding Username}"
                                                   TextColor="Black"/>

                                            <Label Grid.Column="1"
                                                   Text="{Binding UserType}"
                                                   TextColor="Black"/>

                                            <Label Grid.Column="2"
                                                   Text="{Binding GroupName}"
                                                   TextColor="Black"/>

                                            <Grid Grid.Column="3" HorizontalOptions="Center">
                                                <CheckBox IsChecked="{Binding IsActive}"
                                                          InputTransparent="True" />
                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                                                                           Path=BindingContext.ToggleUserActiveCommand}"
                                                                          CommandParameter="{Binding}" />
                                                </Grid.GestureRecognizers>
                                            </Grid>

                                            <Button Grid.Column="4"
                                                    Text="Wijzigen"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                                                    Path=BindingContext.EditUserCommand}"
                                                    CommandParameter="{Binding}" />

                                            <Button Grid.Column="5"
                                                    Text="Verwijderen"
                                                    BackgroundColor="#E57373"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                                                    Path=BindingContext.DeleteUserCommand}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                            <HorizontalStackLayout HorizontalOptions="Center"
                                                   Spacing="40">

                                <Button Text="Vorige"
                                        Command="{Binding PreviousUserPageCommand}"/>

                                <Label Text="{Binding UserPageText}"
                                       TextColor="Black"
                                       VerticalOptions="Center"/>

                                <Button Text="Volgende"
                                        Command="{Binding NextUserPageCommand}"/>
                            </HorizontalStackLayout>

                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="10">

                            <Label Text="Groepen"
                                   FontSize="20"
                                   TextColor="Black"/>

                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  ColumnSpacing="12">

                                <Entry Grid.Column="0"
                                       WidthRequest="220"
                                       Placeholder="Groep zoeken"
                                       Text="{Binding GroupSearchText}"
                                       TextColor="Black"/>

                                <Button Grid.Column="2"
                                        Text="Groep toevoegen"
                                        Command="{Binding AddGroupCommand}"
                                        BackgroundColor="#9B8CF2"
                                        TextColor="Black"/>
                            </Grid>

                            <Grid ColumnDefinitions="*,*,Auto"
                                  Padding="10"
                                  BackgroundColor="#E0E0E0">

                                <Label Text="Groep" TextColor="Black"/>
                                <Label Grid.Column="1" Text="Docent" TextColor="Black"/>
                                <Label Grid.Column="2" Text="Actie" TextColor="Black"/>
                            </Grid>

                            <CollectionView ItemsSource="{Binding Groups}"
                                            HeightRequest="260">

                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*,*,Auto,Auto"
                                              Padding="10"
                                              ColumnSpacing="10">

                                            <Label Text="{Binding Name}"
                                                   TextColor="Black"/>

                                            <Label Grid.Column="1"
                                                   Text="{Binding TeacherName}"
                                                   TextColor="Black"/>

                                            <Button Grid.Column="2"
                                                    Text="Wijzigen"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                                                    Path=BindingContext.EditGroupCommand}"
                                                    CommandParameter="{Binding}" />

                                            <Button Grid.Column="3"
                                                    Text="Verwijderen"
                                                    BackgroundColor="#E57373"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                                                    Path=BindingContext.DeleteGroupCommand}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                            <HorizontalStackLayout HorizontalOptions="Center"
                                                   Spacing="40">

                                <Button Text="Vorige"
                                        Command="{Binding PreviousGroupPageCommand}"/>

                                <Label Text="{Binding GroupPageText}"
                                       TextColor="Black"
                                       VerticalOptions="Center"/>

                                <Button Text="Volgende"
                                        Command="{Binding NextGroupPageCommand}"/>
                            </HorizontalStackLayout>

                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="10">

                            <Label Text="Oefeningen"
                                   FontSize="20"
                                   TextColor="Black"/>

                            <Grid ColumnDefinitions="*,300,200,*"
                                  Padding="10"
                                  BackgroundColor="#E0E0E0">

                                <Label Grid.Column="0" Text="Oefening" TextColor="Black" />
                                <Label Grid.Column="1" Text="Globaal" TextColor="Black" HorizontalTextAlignment="Center"/>
                                <Label Grid.Column="2" Text="School" TextColor="Black" HorizontalTextAlignment="Center"/>
                                <Label Grid.Column="3" Text="Actie" TextColor="Black" HorizontalTextAlignment="End"/>
                            </Grid>

                            <CollectionView ItemsSource="{Binding SchoolExercises}"
                                            HeightRequest="220">

                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*,300,200,*"
                                              Padding="10"
                                              ColumnSpacing="50">

                                            <Label Grid.Column="0"
                                                   Text="{Binding ExerciseName}"
                                                   TextColor="Black"
                                                   VerticalOptions="Center"/>
                                            
                                            <Grid Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center">
                                                <CheckBox IsChecked="{Binding GlobalActive}"
                                                          InputTransparent="True"
                                                          HorizontalOptions="Center"
                                                          VerticalOptions="Center" />
                                            </Grid>
                                            
                                            <Grid Grid.Column="2" HorizontalOptions="Center" VerticalOptions="Center">
                                                <CheckBox IsChecked="{Binding SchoolActive}"
                                                          InputTransparent="True"
                                                          HorizontalOptions="Center"
                                                          VerticalOptions="Center" />
                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                                                                           Path=BindingContext.ToggleSchoolExerciseCommand}"
                                                                          CommandParameter="{Binding}" />
                                                </Grid.GestureRecognizers>
                                            </Grid>

                                            <Button Grid.Column="3"
                                                    Text="Link"
                                                    BackgroundColor="#9B8CF2"
                                                    TextColor="Black"
                                                    MaximumWidthRequest="120"
                                                    HorizontalOptions="End"
                                                    IsVisible="{Binding ShowLinkButton}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                                                      Path=BindingContext.LinkExerciseCommand}"
                                                    CommandParameter="{Binding}" />

                                            <Button Grid.Column="3"
                                                    Text="Unlink"
                                                    BackgroundColor="#E57373"
                                                    TextColor="Black"
                                                    MaximumWidthRequest="120"
                                                    HorizontalOptions="End"
                                                    IsVisible="{Binding ShowUnlinkButton}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                                                      Path=BindingContext.UnlinkExerciseCommand}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

    </local:AdminNavigationView>
</ContentPage>
