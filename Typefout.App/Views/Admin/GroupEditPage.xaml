<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Typefout.App.Views.Admin"
             x:Class="Typefout.App.Views.Admin.GroupEditPage">

    <local:AdminNavigationView>

        <VerticalStackLayout Padding="40">

            <Label Text="{Binding GroupName}" 
                   FontSize="28"
                   HorizontalOptions="Center" />

            <Frame BackgroundColor="#F0F0F0" Padding="30">

                <VerticalStackLayout Spacing="20">

                    <Entry Placeholder="Docent"
                           TextColor="Black"
                           Text="{Binding SelectedTeacherName}" />

                    <Entry Placeholder="Groepsnaam"
                           TextColor="Black"
                           Text="{Binding GroupName}" />

                    <Button Text="Wijzigen"
                            BackgroundColor="#9B8CF2"
                            TextColor="Black"
                            Command="{Binding SaveGroupCommand}" />
                </VerticalStackLayout>

            </Frame>

        </VerticalStackLayout>

    </local:AdminNavigationView>
</ContentPage>