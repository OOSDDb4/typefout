<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Typefout.App.ViewModels"
             x:Class="Typefout.App.Views.SentenceView"
             BackgroundColor="White">

    <VerticalStackLayout Spacing="20" VerticalOptions="Center" HorizontalOptions="Center">

        <Label Text="Typ de zin over:"
               FontSize="40"
               TextColor="Black"
               HorizontalOptions="Center" />

        <Label Text="{Binding TargetText}"
               FontSize="40"
               FontAttributes="Bold"
               TextColor="Black"
               HorizontalOptions="Center" />

        <Label FontSize="30"
               HorizontalOptions="Center">
            <Label.FormattedText>
                <Binding Path="HighlightedText" />
            </Label.FormattedText>
        </Label>

        <Entry Text="{Binding InputText}"
               Placeholder="Typ hier..."
               WidthRequest="400"
               FontSize="30"
               TextColor="Black"
               HorizontalTextAlignment="Center" />

    </VerticalStackLayout>
</ContentPage>