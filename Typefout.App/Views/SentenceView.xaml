<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Typefout.App.ViewModels"
             x:Class="Typefout.App.Views.SentenceView"
             BackgroundColor="White">

    <VerticalStackLayout Spacing="20" HorizontalOptions="Center">
        
        <Grid Padding="0,20,0,100" VerticalOptions="Start" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width= "900"/>
            </Grid.ColumnDefinitions>

            <VerticalStackLayout Grid.Column="0" Spacing="5">
                <Label Text="Typefout"
                       FontSize="48"
                       HorizontalOptions="Start"
                       FontAttributes="Bold"
                       TextColor="Black"/>
            </VerticalStackLayout>

            <Button Grid.Column="1"
                    Text="Stoppen"
                    VerticalOptions="Start"
                    HorizontalOptions="End"
                    BackgroundColor="#D3D3D3"
                    TextColor="Black"
                    FontSize="20"
                    Command="{Binding StopExerciseCommand}"/>
        </Grid>

        <Label Text="Typ de zin over:"
               FontSize="40"
               TextColor="Black"
               HorizontalOptions="Center" />

        <Label Text="{Binding TargetText}"
               FontSize="40"
               FontAttributes="Bold"
               TextColor="Black"
               HorizontalOptions="Center" />

        <Label FontSize="30"
               HorizontalOptions="Center">
            <Label.FormattedText>
                <Binding Path="HighlightedText" />
            </Label.FormattedText>
        </Label>

        <Entry Text="{Binding InputText}"
               Placeholder="Typ hier..."
               WidthRequest="400"
               FontSize="30"
               TextColor="Black"
               HorizontalTextAlignment="Center" />

    </VerticalStackLayout>
</ContentPage>