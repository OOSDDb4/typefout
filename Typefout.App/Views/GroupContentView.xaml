<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Typefout.App.ViewModels"
             x:Class="Typefout.App.Views.GroupContentView"
             x:DataType="viewmodels:GroupContentViewModel">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" />
    </Shell.BackButtonBehavior>

    <Border BackgroundColor="#E0E0E0" 
            StrokeShape="RoundRectangle 10" 
            Padding="30" 
            VerticalOptions="FillAndExpand">

        <StackLayout Spacing="20">

            <Grid ColumnDefinitions="*, Auto, Auto" Margin="0, 0, 0, 20">
                <Frame Grid.Column="0" 
                       Padding="5" 
                       CornerRadius="5" 
                       BackgroundColor="White" 
                       HorizontalOptions="Start"
                       WidthRequest="200">
                    <Label Text="Zoeken" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Frame>
                <Button Grid.Column="2" 
                        Text="Groepen aanmaken" 
                        BackgroundColor="White" 
                        TextColor="Black" 
                        CornerRadius="5" 
                        HeightRequest="30"
                        HorizontalOptions="End"/>
            </Grid>

            <Grid ColumnDefinitions="*, *, Auto, Auto, Auto" 
                  RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, *"
                  RowSpacing="1" 
                  ColumnSpacing="1"
                  VerticalOptions="Start">

                <Label Grid.Row="0" Grid.Column="0" Text="Groep" FontAttributes="Bold" BackgroundColor="White" Padding="10, 5"/>
                <Label Grid.Row="0" Grid.Column="1" Text="Docent" FontAttributes="Bold" BackgroundColor="White" Padding="10, 5"/>
                <Image Grid.Row="0" Grid.Column="2" BackgroundColor="White">
                    <ImageButton.Source>
                        <FontImageSource
                        Glyph="&#xf007;"
                        FontFamily="FontAwesomeSolid"
                        Size="30"
                        Color="Black"/>
                </ImageButton.Source>
                </Image>
                <Label Grid.Row="0" Grid.Column="3" Text="info" FontAttributes="Bold" BackgroundColor="White" Padding="10, 5"/>
                <Label Grid.Row="0" Grid.Column="4" Text="Wijzigen" FontAttributes="Bold" BackgroundColor="White" Padding="10, 5"/>

                <VerticalStackLayout Grid.Row="1" Grid.ColumnSpan="5"
                                     BindableLayout.ItemsSource="{Binding Groups}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:GroupContentViewModel">
                            <Grid ColumnDefinitions="*, *, Auto, Auto, Auto" 
                                  ColumnSpacing="1">
                                <Label Grid.Column="0" Text="{Binding GroupName}" 
                                       BackgroundColor="White" TextColor="Black" Padding="10, 5"/>
                                <Label Grid.Column="1" Text="{Binding Teacher}" 
                                       BackgroundColor="White" TextColor="Black" Padding="10, 5"/>
                                <Label Grid.Column="2" Text="{Binding StudentCount}" 
                                       BackgroundColor="White" TextColor="Black" Padding="10, 5"/>
                                <Label Grid.Column="3" Text="info" 
                                       BackgroundColor="White" TextColor="Black" Padding="10, 5"/>
                                <Label Grid.Column="4" Text="Wijzigen" 
                                       BackgroundColor="White" TextColor="Black" Padding="10, 5"/>
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Grid>
        </StackLayout>
    </Border>
</ContentView>